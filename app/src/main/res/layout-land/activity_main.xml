<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="@dimen/main_padding_h"
    android:paddingEnd="@dimen/main_padding_h"
    android:paddingTop="@dimen/main_padding_v"
    android:paddingBottom="@dimen/main_padding_v"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:orientation="vertical"
        android:paddingEnd="@dimen/main_section_gap">

        <TextView
            android:id="@+id/txt_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="6dp"
            android:paddingBottom="3dp"
            android:text="@string/url"
            android:textColor="?android:attr/textColorPrimary"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:textStyle="bold|italic"/>

        <TextView
            android:id="@+id/txt_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="3dp"
            android:paddingBottom="6dp"
            android:text="@string/key"
            android:textColor="?android:attr/textColorPrimary"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:textStyle="bold|italic"/>

        <Button
            android:id="@+id/btn_sm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_action_height"
            android:layout_marginTop="@dimen/main_section_gap"
            android:background="@drawable/ripple"
            android:maxLines="1"
            android:onClick="startQrCode"
            android:text="@string/sm"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_action_height"
            android:layout_marginTop="@dimen/main_section_gap"
            android:background="@drawable/ripple"
            android:maxLines="1"
            android:onClick="doInput"
            android:text="@string/pz"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_action_height"
            android:layout_marginTop="@dimen/main_section_gap"
            android:background="@drawable/ripple"
            android:maxLines="1"
            android:onClick="doStart"
            android:text="@string/xt"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btn_checkpush"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_action_height"
            android:layout_marginTop="@dimen/main_section_gap"
            android:background="@drawable/ripple"
            android:maxLines="1"
            android:onClick="checkPush"
            android:text="@string/jt"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical"
        android:paddingStart="@dimen/main_section_gap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:onClick="Logs"
                android:text="@string/ht_state"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/sj_dl"
                style="@style/AppTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:onClick="dl"
                android:text="@string/dl"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold|italic"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/log_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:padding="5dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/state_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="top"
                android:lineSpacingExtra="2dp"
                android:overScrollMode="always"
                android:textColor="#07DD0C"
                android:textIsSelectable="true"
                android:textSize="10sp"/>
        </ScrollView>

        <TextView
            android:id="@+id/bq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:gravity="center"
            android:onClick="openAuthorWebsite"
            android:text="@string/bq"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
